# DineFlow Backend Configuration Example

PORT=5000

# PostgreSQL Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=dineflow

# JWT Settings
JWT_SECRET=supersecretkeyreplaceinproduction123456
JWT_EXPIRES_IN=7d

# CORS Settings
# Use a comma-separated list of allowed origins for frontend deployments.
# Example: http://localhost:5173,https://my-dineflow.vercel.app
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Email Provider (optional)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@dineflow.app

# SMS Provider (optional Twilio credentials)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890
